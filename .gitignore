# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
Unlock/.idea
UnlockAll/.idea

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
MANIFEST

# ── PyInstaller ──────────────────────────────────────────────────────────────
# Compiled output – regenerated by `pyinstaller build.spec` (already covered above)
# Keep hand-edited .spec files (e.g. build.spec), but ignore auto-generated ones
*.spec
!build.spec

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
*.lnk
$RECYCLE.BIN/

# ── QSettings / runtime config ───────────────────────────────────────────────
# Ignore auto-generated config files; keep manually committed ones if any
*.ini
*.cfg
tmp/
test.py


# ── OpenCode 工作区 ───────────────────────────────────────────────────────────
.opencode/*
!.opencode/instructions.md

# ── 临时 / 探查 / 开发笔记（不属于正式代码库）────────────────────────────────
tests/
experiments/
examples/

# ── Office 临时文件 ───────────────────────────────────────────────────────────
~$*

# ── Temp 目录 ─────────────────────────────────────────────────────────────────
Temp/
